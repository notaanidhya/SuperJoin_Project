# Google Gemini API Key (Required for live fact extraction & reasoning)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-3.5-flash-lite is recommended for free tier (15 RPM, 1,500 RPD)
GEMINI_MODEL=gemini-3.5-flash-lite

# Pacing delay between LLM calls in seconds (4.2s guarantees staying under 15 RPM)
RATE_LIMIT_DELAY_SECONDS=4.2

# Default candidate cosine similarity threshold
CONFIDENCE_THRESHOLD=0.60
